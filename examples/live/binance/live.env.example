# Copy this file to examples/live/binance/runtime/live.env before running the runtime manager.
# Use either direct values or *_FILE references for credentials, not both.

export BINANCE_API_KEY="replace-with-live-or-demo-key"
export BINANCE_API_SECRET="replace-with-live-or-demo-secret"
# export BINANCE_API_KEY_FILE="../../../../secrets/binance_api_key.txt"
# export BINANCE_API_SECRET_FILE="../../../../secrets/binance_api_secret.txt"

# Runtime defaults for the accepted micro-live lane.
export CTREND_BINANCE_ENVIRONMENT="live"
export CTREND_TRADER_ID="CTREND-LIVE-001"
export CTREND_RESEARCH_CONFIG="examples/backtest/crypto_rv/configs/ctrend.real_public_q1.json"
export CTREND_SHORT_BAND="rank_1_20"
export CTREND_SHORT_FALLBACK_BANDS="rank_1_30,rank_1_50"
export CTREND_MIN_ACTIVE_SHORTS="4"
export CTREND_LEG_NOTIONAL_USD="75"
export CTREND_INITIAL_LEVERAGE="2"
export CTREND_HISTORY_LOOKBACK_DAYS="90"
export CTREND_ORDER_EXPIRE_SECONDS="900"
export CTREND_LOG_LEVEL="INFO"

# Kill-switch thresholds. Keep these aligned with the account size you actually fund.
export CTREND_STARTING_EQUITY_USDT="200"
export CTREND_MAX_TOTAL_DRAWDOWN_USDT="20"
export CTREND_MAX_DAILY_LOSS_USDT="6"
export CTREND_MIN_AVAILABLE_BALANCE_USDT="50"
export CTREND_KILL_SWITCH_CHECK_INTERVAL_SECS="60"

# Official prebuilt Nautilus wheel used to avoid source builds on small servers.
export CTREND_WHEEL_SPEC="nautilus_trader==1.226.0a20260414"
