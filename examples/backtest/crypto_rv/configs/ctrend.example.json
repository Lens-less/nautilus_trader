{
  "schema_version": "1.0",
  "research_name": "crypto-ctrend-example",
  "snapshot_path": "../output/example_snapshot.json",
  "prepared_catalog_path": "../output/example_prepared_catalog.json",
  "output_dir": "../output/ctrend_runs",
  "report_output_path": "../output/ctrend_report.json",
  "baseline_long_instrument_ids": [
    "BTCUSDT-PERP.BINANCE",
    "ETHUSDT-PERP.BINANCE",
    "SOLUSDT-PERP.BINANCE",
    "BNBUSDT-PERP.BINANCE",
    "HYPEUSDT-PERP.BINANCE"
  ],
  "strategy": {
    "strategy_path": "nautilus_trader.examples.strategies.crypto_xsec_trend:CryptoXSecTrendStrategy",
    "config_path": "nautilus_trader.examples.strategies.crypto_xsec_trend:CryptoXSecTrendConfig",
    "allow_placeholder_runner": true
