  },
  "cost_models": {
    "base": {
      "fee_bps": 4.0,
      "slippage_bps": 8.0,
      "short_borrow_bps_annual": 0.0,
      "notes": "Phase-one CTREND baseline."
    },
    "stress": {
      "fee_bps": 8.0,
      "slippage_bps": 25.0,
      "short_borrow_bps_annual": 300.0,
      "notes": "Stress branch for CTREND."
    }
  }
}
